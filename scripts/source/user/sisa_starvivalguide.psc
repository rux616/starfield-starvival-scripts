Function RestoreJumpSprint()
    
	InputEnableLayer inputLayer
	
	Float JumpRestoreIfNegative = - PlayerRef.GetValue(JumpMult)
	Float JumpMultValue = PlayerRef.GetValue(JumpMult)    
		
	inputLayer.EnableRunning(true)
	inputLayer.EnableSprinting(true)
    
	If JumpMultValue < 0
	   PlayerRef.RestoreValue(JumpMult, JumpRestoreIfNegative)
 EndIf
	
EndFunction

