Function UseWorkbench(ObjectReference akFurniture)
          
	  If akFurniture.HasKeyword(KWD_WorkbenchArmor) 
				
				If PlayerRef.GetValue(AV_CondSuit) < 100.0
		           PlayerRef.AddItem(ARMOR_Suit, 1, True)
             EndIf
	            If PlayerRef.GetValue(AV_CondBoostpack) < 100.0		 
		           PlayerRef.AddItem(ARMOR_Boostpack, 1, True)
             EndIf		 
	            If PlayerRef.GetValue(AV_CondHelmet) < 100.0		 
		           PlayerRef.AddItem(ARMOR_Helmet, 1, True)
             EndIf	  
  
  ElseIf akFurniture.haskeyword(KWD_WorkbenchWeapon)  
				
				If PlayerRef.GetValue(AV_CondHandgun) < 100.0
		           PlayerRef.AddItem(WEAPON_Handgun, 1, True)
             EndIf	 
				If PlayerRef.GetValue(AV_CondHandgunLaser) < 100.0
		           PlayerRef.AddItem(WEAPON_HandgunLaser, 1, True)
             EndIf	
				If PlayerRef.GetValue(AV_CondHandgunParticle) < 100.0
		           PlayerRef.AddItem(WEAPON_HandgunParticle, 1, True)
             EndIf	
				If PlayerRef.GetValue(AV_CondHandgunAuto) < 100.0
		           PlayerRef.AddItem(WEAPON_HandgunAuto, 1, True)
             EndIf	
				If PlayerRef.GetValue(AV_CondHandgunAutoLaser) < 100.0
		           PlayerRef.AddItem(WEAPON_HandgunAutoLaser, 1, True)
             EndIf	
				If PlayerRef.GetValue(AV_CondHandgunAutoParticle) < 100.0
		           PlayerRef.AddItem(WEAPON_HandgunAutoParticle, 1, True)
             EndIf	
				If PlayerRef.GetValue(AV_CondRifle) < 100.0
		           PlayerRef.AddItem(WEAPON_Rifle, 1, True)
             EndIf	
				If PlayerRef.GetValue(AV_CondRifleLaser) < 100.0
		           PlayerRef.AddItem(WEAPON_RifleLaser, 1, True)
             EndIf	
				If PlayerRef.GetValue(AV_CondRifleParticle) < 100.0
		           PlayerRef.AddItem(WEAPON_RifleParticle, 1, True)
             EndIf	
				If PlayerRef.GetValue(AV_CondRifleAuto) < 100.0
		           PlayerRef.AddItem(WEAPON_RifleAuto, 1, True)
             EndIf	
				If PlayerRef.GetValue(AV_CondRifleAutoLaser) < 100.0
		           PlayerRef.AddItem(WEAPON_RifleAutoLaser, 1, True)
             EndIf	
				If PlayerRef.GetValue(AV_CondRifleAutoParticle) < 100.0
		           PlayerRef.AddItem(WEAPON_RifleAutoParticle, 1, True)
             EndIf	
				If PlayerRef.GetValue(AV_CondRifleEM) < 100.0
		           PlayerRef.AddItem(WEAPON_RifleEM, 1, True)
             EndIf
				If PlayerRef.GetValue(AV_CondShotgun) < 100.0
		           PlayerRef.AddItem(WEAPON_Shotgun, 1, True)
             EndIf	
				If PlayerRef.GetValue(AV_CondShotgunParticle) < 100.0
		           PlayerRef.AddItem(WEAPON_ShotgunParticle, 1, True)
             EndIf	
				If PlayerRef.GetValue(AV_CondHeavy) < 100.0
		           PlayerRef.AddItem(WEAPON_Heavy, 1, True)
             EndIf	
				If PlayerRef.GetValue(AV_CondHeavyParticle) < 100.0
		           PlayerRef.AddItem(WEAPON_HeavyParticle, 1, True)
             EndIf	
				If PlayerRef.GetValue(AV_CondExplosive) < 100.0
		           PlayerRef.AddItem(WEAPON_Explosive, 1, True)
             EndIf	
				If PlayerRef.GetValue(AV_CondExplosiveParticle) < 100.0
		           PlayerRef.AddItem(WEAPON_ExplosiveParticle, 1, True)
             EndIf	
				If PlayerRef.GetValue(AV_CondMelee) < 100.0
		           PlayerRef.AddItem(WEAPON_Melee, 1, True)
             EndIf	
				If PlayerRef.GetValue(AV_CondTool) < 100.0
