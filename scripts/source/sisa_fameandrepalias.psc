Event Actor.OnPlayerJail(Actor akSender, ObjectReference akGuard, Form akFaction, Location akLocation, Int aeCrimeGold)
         
         Int JailMin = RepOnBeingInJailMIN.GetValue() as Int		 
         Int JailMax = RepOnBeingInJailMAX.GetValue() as Int	
         Float JailMinCF = 0.15		 
         Float JailMaxCF = 0.30		
		 Int ReputationDMG = Utility.RandomInt(JailMin, JailMax)
		 Float ReputationDMGCF = Utility.RandomFloat(JailMinCF, JailMaxCF) 	     
		 
		 ActorValue AVCheck = CheckForAV()   
		 
		 If PlayerRef.GetValue(AVCheck) >= 40
		    PlayerRef.DamageValue(AVCheck, ReputationDMG)
		    PlayerRef.RestoreValue(AV_ReputationCF, ReputationDMGCF)
		      Utility.Wait(0.5)		 
		      If PlayerRef.GetValue(AVCheck) < 40
		         PlayerRef.RestoreValue(AVCheck, 999)
		         PlayerRef.DamageValue(AVCheck, 60)
	       EndIf
	  EndIf 
     		 
EndEvent

