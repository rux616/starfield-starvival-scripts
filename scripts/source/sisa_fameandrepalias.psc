Function OnQuestComplete(ActorValue ReputationFaction01, ActorValue ReputationFaction02, Float RepAdd, Float RepRemove, Float FameAdd, Message MSG)
		 PlayerRef.RestoreValue(ReputationFaction01, RepAdd / 2)
		 PlayerRef.RestoreValue(ReputationFaction02, RepAdd)
		 PlayerRef.DamageValue(ReputationFaction01, RepRemove / 2)	
		 PlayerRef.DamageValue(ReputationFaction02, RepRemove)
		 PlayerRef.RestoreValue(Fame, FameAdd)	
         MSG.Show()
EndFunction

